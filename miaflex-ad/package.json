{
  "name": "miaflex-ad",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audio": "python3 scripts/make_audio.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MiaflexAd out/miaflex_ad.mp4 --codec=h264 --crf=18 --audio-codec=aac --concurrency=4",
    "sheet": "node scripts/contact-sheet.mjs",
    "still": "remotion still src/index.ts MiaflexAd",
    "typecheck": "tsc --noEmit",
    "build": "npm run audio && npm run render && npm run sheet"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "typescript": "5.6.3"
  }
}
